//@version=6
indicator("Seller Exhaustion Index (SEC)", overlay=false, precision=4)

// ─── 参数 ───────────────────────────────────────────────────
volPeriod   = input.int(30, "波动率周期", minval=10, maxval=90)
winPeriod   = input.int(1460, "百分位窗口 (4Y≈1460)", minval=365, maxval=2920)
threshold   = input.float(0.01, "极端衰竭阈值", step=0.005)

// ─── 30日年化波动率 ─────────────────────────────────────────
// 对数收益率的标准差 × sqrt(365)
logRet      = math.log(close / close[1])
vol30       = ta.stdev(logRet, volPeriod) * math.sqrt(365)

// ─── Supply in Profit Proxy (4Y 滚动百分位) ────────────────
// 当前价格在过去 winPeriod 根 bar 中排第几名（0~1）
// 直接用 ta.percentrank 实现
supplyProfit = ta.percentrank(close, winPeriod) / 100.0

// ─── Seller Exhaustion Index ────────────────────────────────
sec = supplyProfit * vol30

// ─── 绘图 ───────────────────────────────────────────────────
// SEC 主线
secColor = sec < threshold ? color.rgb(0, 211, 149) : sec < 0.05 ? color.rgb(59, 130, 246) : color.rgb(156, 163, 175)
plot(sec, "SEC", color=secColor, linewidth=2)

// 极端衰竭阈值线
hline(threshold, "极端衰竭 (0.01)", color=color.new(color.red, 40), linestyle=hline.style_dashed, linewidth=1)
hline(0.05, "低位警戒 (0.05)", color=color.new(color.orange, 60), linestyle=hline.style_dotted, linewidth=1)

// 背景高亮极端衰竭区
bgcolor(sec < threshold ? color.new(color.green, 85) : na, title="极端衰竭区")

// ─── 信息面板 ───────────────────────────────────────────────
var table infoTable = table.new(position.top_right, 2, 4, border_width=1)
if barstate.islast
    table.cell(infoTable, 0, 0, "SEC", text_color=color.white, bgcolor=color.gray)
    table.cell(infoTable, 1, 0, str.tostring(sec, "#.####"), text_color=sec < threshold ? color.green : color.white, bgcolor=color.gray)
    table.cell(infoTable, 0, 1, "波动率", text_color=color.white, bgcolor=color.gray)
    table.cell(infoTable, 1, 1, str.tostring(vol30 * 100, "#.#") + "%", text_color=color.white, bgcolor=color.gray)
    table.cell(infoTable, 0, 2, "百分位", text_color=color.white, bgcolor=color.gray)
    table.cell(infoTable, 1, 2, str.tostring(supplyProfit * 100, "#.#") + "%", text_color=color.white, bgcolor=color.gray)
    table.cell(infoTable, 0, 3, "状态", text_color=color.white, bgcolor=color.gray)
    status = sec < threshold ? "🟢 极端衰竭" : sec < 0.05 ? "🔵 低位" : sec < 0.2 ? "⚪ 中性" : "🔴 高位"
    table.cell(infoTable, 1, 3, status, text_color=sec < threshold ? color.green : color.white, bgcolor=color.gray)
